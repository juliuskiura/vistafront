# Deployment status used at build time.
#   development (default) -> localhost API URLs (http://127.0.0.1:8000 / http://localhost:8000)
#   staging               -> https://app.vistasolve.net (https)
#   production            -> https://app.vistasolve.net (https)
# Set it before building, e.g.:
#   NEXT_STATUS=staging npm run build     (or: npm run build:staging)
#   NEXT_STATUS=production npm run build  (or: npm run build:prod)
NEXT_STATUS=development

# Optional overrides. When set, these win over the NEXT_STATUS defaults:
# BACKEND_URL=https://app.vistasolve.net
# NEXT_PUBLIC_BACKEND_URL=https://app.vistasolve.net
# API_PROXY_TARGET=https://app.vistasolve.net