# Deployment status, used at build time to pick the public origin.
#   development (default) -> https://app.vistasolve.net
#   production            -> https://app.vistasolve.com
# Set it before building, e.g.:
#   NEXT_STATUS=production npm run build   (or: npm run build:prod)
NEXT_STATUS=development

# The browser needs NO environment variables. The app and Django are served
# from one host: nginx routes /apis/, /media/ and /ws/ to Django and everything
# else to Next.js, so client code uses relative paths (or window.location.origin)
# and lands on the right process everywhere. Do not add a NEXT_PUBLIC_* backend
# URL back -- baking a backend origin into the client bundle is what made the
# OAuth popup reject valid postMessage events.

# Server-side only. Optional: these win over the NEXT_STATUS-derived defaults.
# BACKEND_URL=http://127.0.0.1:8000        # server-to-server Django base
# API_PROXY_TARGET=http://127.0.0.1:8000   # where the /apis/ + /media/ rewrites go
# APP_BASE_URL=https://app.vistasolve.net  # absolute public origin (emails, SSR)
